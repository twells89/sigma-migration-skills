            "source": {
              "connectionId": "<CONNECTION_ID>",
              "kind": "sql",
              "statement": "SELECT d AS \"Date\", EXTRACT(YEAR FROM d) AS \"Year\", EXTRACT(MONTH FROM d) AS \"Month No\", TO_CHAR(d, 'Mon') AS \"Month\", EXTRACT(QUARTER FROM d) AS \"Quarter No\"\nFROM (\n  SELECT DATEADD('day', SEQ4(), CAST('2018-01-01' AS DATE)) AS d\n  FROM TABLE(GENERATOR(ROWCOUNT => 3287))\n)"
